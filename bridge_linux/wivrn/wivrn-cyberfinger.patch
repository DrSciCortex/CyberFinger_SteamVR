 {
+#ifdef WIVRN_FEATURE_CYBERFINGER
+	if (cyberfinger)
+	{
+		// A hand again, not a controller: the headset tracks its aim, pinch and poke poses,
+		// which for a controller are derived from the grip
+		if (cyberfinger->TakeActivation())
+		{
+			for (auto list: {&aim, &pinch_ext, &poke_ext})
+				list->set_derived(list, XRT_POSE_IDENTITY);
