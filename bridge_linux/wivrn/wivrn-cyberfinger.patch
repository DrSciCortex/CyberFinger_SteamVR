+# CyberFinger (https://github.com/SciCortex/CyberFinger_SteamVR): its driver's settings, in the settings page.
+# Built from a checkout of that repository, like the driver in the server.
+set(WIVRN_CYBERFINGER_DIR "" CACHE PATH "CyberFinger_SteamVR checkout to build the CyberFinger driver from (empty: without it)")
+if (NOT WIVRN_CYBERFINGER_DIR)
+    message(FATAL_ERROR "This dashboard has the CyberFinger settings: set WIVRN_CYBERFINGER_DIR to the CyberFinger_SteamVR checkout")
+endif()
+set(CYBERFINGER_DASHBOARD_DIR ${WIVRN_CYBERFINGER_DIR}/bridge_linux/wivrn/dashboard)
+set_source_files_properties(${CYBERFINGER_DASHBOARD_DIR}/CyberFingerSettings.qml PROPERTIES
+    QT_RESOURCE_ALIAS qml/CyberFingerSettings.qml
+)
+qt_target_qml_sources(wivrn-dashboard QML_FILES ${CYBERFINGER_DASHBOARD_DIR}/CyberFingerSettings.qml)
+target_sources(wivrn-dashboard PRIVATE
+    ${CYBERFINGER_DASHBOARD_DIR}/cyberfinger_config.cpp
+    ${CYBERFINGER_DASHBOARD_DIR}/cyberfinger_config.h
+)
+target_include_directories(wivrn-dashboard PRIVATE ${CYBERFINGER_DASHBOARD_DIR})
+
 configure_file(gui_config.h.in gui_config.h)
 configure_file(io.github.wivrn.wivrn.desktop.in io.github.wivrn.wivrn.desktop)
 
